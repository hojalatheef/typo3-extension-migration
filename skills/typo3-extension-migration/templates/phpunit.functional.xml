<?xml version="1.0"?>
<!--
    Build/phpunit/FunctionalTests.xml - functional tests with typo3/testing-framework.
    Assumes composer.json: config.vendor-dir = ".Build/vendor", extra.typo3/cms.web-dir = ".Build/public".
    Placeholders:
      __PHPUNIT_SCHEMA__  PHPUnit minor for the XSD, e.g. 11.5 (TF 9) / 10.5 (TF 8)
    Database: SQLite by default (no server needed). For MySQL/MariaDB/Postgres override via env:
      typo3DatabaseDriver=mysqli typo3DatabaseHost=127.0.0.1 typo3DatabaseName=func typo3DatabaseUsername=root typo3DatabasePassword=root
    Run: .Build/vendor/bin/phpunit -c Build/phpunit/FunctionalTests.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/__PHPUNIT_SCHEMA__/phpunit.xsd"
         backupGlobals="true"
         bootstrap="../../.Build/vendor/typo3/testing-framework/Resources/Core/Build/FunctionalTestsBootstrap.php"
         cacheDirectory="../../.Build/.cache/phpunit-functional"
         cacheResult="false"
         colors="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnRisky="true"
         failOnWarning="true"
         requireCoverageMetadata="false"
>
    <testsuites>
        <testsuite name="Functional tests">
            <directory>../../Tests/Functional/</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="display_errors" value="1"/>
        <env name="TYPO3_CONTEXT" value="Testing"/>
        <env name="typo3DatabaseDriver" value="pdo_sqlite" force="false"/>
    </php>
</phpunit>
